# Server Configuration
PORT=5005
HOST=0.0.0.0
NODE_ENV=development

# IPFS Configuration
IPFS_PINNING_SERVICE=https://api.pinata.cloud
IPFS_PINNING_KEY=your_pinata_jwt_token_here

# IPFS Gateway (fallback for fetching)
IPFS_GATEWAY=https://ipfs.io

# Read-Only Blockchain Access
RPC_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Blockchain Sync
USE_BLOCKCHAIN_SYNC=true
SYNC_INTERVAL_MINUTES=2

# Archival Service (IPFS pin verification)
# ARCHIVE_TTL_DAYS - How long to keep submissions pinned after bounty closes (default: 30)
# ARCHIVE_AFTER_RETRIEVAL_DAYS - How long to keep after poster retrieves (default: 7)
# PIN_VERIFY_INTERVAL_HOURS - How often to verify pins are still available (default: 1)
# VERIFICATION_RATE_LIMIT_MS - Delay between verification API calls to avoid rate limits (default: 250)
ARCHIVE_TTL_DAYS=30
ARCHIVE_AFTER_RETRIEVAL_DAYS=7
PIN_VERIFY_INTERVAL_HOURS=1
VERIFICATION_RATE_LIMIT_MS=250

# Contract Configuration
# Select which network to use (the server reads the matching address below)
NETWORK=base-sepolia
# Required: BountyEscrow addresses per network.
# Get the current values from the running website's Analytics page
# (/analytics → System Health → Contract Addresses) or from onchain/deployments/*.json.
# The Verdikta aggregator (one serves every jury size) is read from the escrow (aggregator()) at
# startup — you do NOT need to set it (VERDIKTA_AGGREGATOR_* below overrides). Evaluations are paid in ETH,
# so there is no LINK token address to configure.
BOUNTY_ESCROW_ADDRESS_BASE_SEPOLIA=
BOUNTY_ESCROW_ADDRESS_BASE=
# Optional: the v2 aggregator. Normally read from the escrow (aggregator()) at startup; set this
# to override. Each bounty carries its own jury (K, M, N, P, timeout), so there is one per network.
VERDIKTA_AGGREGATOR_BASE_SEPOLIA=
VERDIKTA_AGGREGATOR_BASE=
# Optional: the block the aggregator was deployed at (event scans start here).
VERDIKTA_AGGREGATOR_DEPLOY_BLOCK_BASE_SEPOLIA=
VERDIKTA_AGGREGATOR_DEPLOY_BLOCK_BASE=
# Optional round keeper: a funded hot wallet that moves in-flight rounds along (drawJury,
# closeCommits, promote, closeFailedRound, expireRerun) and withdraws its own rewards.
# Leave empty to leave those steps to hunters and others. Keep only a little ETH on it.
KEEPER_PRIVATE_KEY=
# Optional RPC override (defaults to public Base RPC for the selected network)
RPC_URL=
CHAIN_ID=

# Optional: Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Client Identification
# FRONTEND_CLIENT_KEY - Shared secret with web frontend (must match VITE_CLIENT_KEY in client/.env)
# FRONTEND_ALLOWED_ORIGINS - Comma-separated list of allowed origins for frontend requests
FRONTEND_CLIENT_KEY=your-frontend-secret-key-here
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bot API Key for CLI scripts (register via POST /api/bots/register)
# Used by scripts in server/scripts/ to authenticate with the API
BOT_API_KEY=

# Optional: CoinGecko Demo API key for the ETH price fallback (Coinbase spot is primary).
# Without it the fallback still tries CoinGecko's keyless API, which CoinGecko may refuse.
COINGECKO_API_KEY=

# Receipts-as-memes
# Used to generate stable pseudonymous agent IDs in public receipts.
# IMPORTANT: keep this secret; changing it will change all pseudonyms.
RECEIPT_SALT=change-me

# Private key for signing transactions (without 0x prefix)
# PRIVATE_KEY=your_private_key_here
# API_URL=http://localhost:5005

