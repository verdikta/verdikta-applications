REACT_APP_NETWORK=base
# Aggregator addresses (comma-separated), one name and one class per address below.
# This client speaks the v2 ReputationAggregator only (9-argument request, drawJury and
# promote from the user's wallet); the v1 aggregators do not work with it.
# TODO(v2 deploy): replace the placeholders with the v2 aggregator addresses on Base and
# Base Sepolia. Entries that are not addresses are skipped, so until then no aggregator
# is offered.
REACT_APP_CONTRACT_ADDRESSES=V2_AGGREGATOR_ADDRESS_BASE,V2_AGGREGATOR_ADDRESS_BASE_SEPOLIA
REACT_APP_CONTRACT_NAMES=Aggregator,Aggregator Base Sepolia Testnet
REACT_APP_CONTRACT_CLASSES=128,128
PORT=3001
REACT_APP_SERVER_URL=http://<ServerIPAddress>:5001
# Or, if using nginx for https, something like this: REACT_APP_SERVER_URL=https://playground.verdikta.org
