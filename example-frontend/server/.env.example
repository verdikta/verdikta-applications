PORT=5000
IPFS_PINNING_SERVICE=https://api.pinata.cloud
IPFS_PINNING_KEY=your_pinata_jwt_token

# Admin wallet addresses (comma-separated, these cannot be removed via UI)
ADMIN_ADDRESSES=0x1234567890123456789012345678901234567890

# Optional fallback aggregator when client/.env lists none. It must be a v2
# ReputationAggregator (the v1 aggregators do not accept v2 requests).
# TODO(v2 deploy): fill in once the v2 aggregator is deployed.
# DEFAULT_AGGREGATOR_ADDRESS=
