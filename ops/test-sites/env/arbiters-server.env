# TEST arbiters server settings -> /root/verdikta/applications-test/example-arbiters/server/.env
# PORT comes from the unit. The v2 TEST deployment's aggregator and the deploy blocks of the aggregator
# and its keeper (event-scan floors). Fill in after the v2 deploy.
AGGREGATOR_ADDRESS_BASE_SEPOLIA=
AGGREGATOR_FROM_BLOCK_BASE_SEPOLIA=
KEEPER_FROM_BLOCK_BASE_SEPOLIA=
AGGREGATOR_ADDRESS_BASE=
AGGREGATOR_FROM_BLOCK_BASE=
KEEPER_FROM_BLOCK_BASE=
# Loopback only: nginx is the only client (the server also defaults to 127.0.0.1).
HOST=127.0.0.1
LOG_LEVEL=info
