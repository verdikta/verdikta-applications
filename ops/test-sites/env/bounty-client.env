# TEST bounty client build settings -> /root/verdikta/applications-test/example-bounty-program/client/.env
# Same-origin API (nginx proxies /api to the test server). VITE_NETWORK is set per build by deploy.sh.
VITE_API_URL=
VITE_API_TIMEOUT=30000
VITE_IPFS_GATEWAY=https://ipfs.io
VITE_ENABLE_DEBUG=false
# Must equal FRONTEND_CLIENT_KEY in the TEST secrets file (a new value, not production's)
VITE_CLIENT_KEY=
# The v2 TEST escrow (and, display-only, its aggregator), the same addresses as bounty-server.env.
# Required: src/config.js throws at load without the active network's escrow, so a build missing it
# serves a blank page. deploy.sh builds both networks from this one file: fill in BASE only once a v2
# mainnet test deployment exists (until then the dist-test-base build stays blank and unserved).
VITE_BOUNTY_ESCROW_ADDRESS_BASE_SEPOLIA=
VITE_VERDIKTA_AGGREGATOR_ADDRESS_BASE_SEPOLIA=
VITE_BOUNTY_ESCROW_ADDRESS_BASE=
VITE_VERDIKTA_AGGREGATOR_ADDRESS_BASE=
