# TEST bounty server settings -> /root/verdikta/applications-test/example-bounty-program/server/.env
# One file serves both test units (base :6005, base-sepolia :6006); NETWORK, PORT, PUBLIC_SITE_URL and
# VERDIKTA_TMP_DIR come from each systemd unit. Keys and API secrets go in the test secrets file
# (secrets-test.env.secrets.template), never here and never production's.
HOST=127.0.0.1
USE_BLOCKCHAIN_SYNC=true
SYNC_INTERVAL_SECONDS=60

# v2 contracts of the TEST deployment (fill in after the v2 deploy; nothing here is production's)
BOUNTY_ESCROW_ADDRESS_BASE_SEPOLIA=
VERDIKTA_AGGREGATOR_BASE_SEPOLIA=
VERDIKTA_AGGREGATOR_DEPLOY_BLOCK_BASE_SEPOLIA=
# Base mainnet v2 test deployment (only once it exists; until then leave the base unit stopped)
BOUNTY_ESCROW_ADDRESS_BASE=
VERDIKTA_AGGREGATOR_BASE=
VERDIKTA_AGGREGATOR_DEPLOY_BLOCK_BASE=

IPFS_PINNING_SERVICE=https://api.pinata.cloud
IPFS_GATEWAY=https://ipfs.io

FRONTEND_ALLOWED_ORIGINS=https://test.bounties.verdikta.org,https://test.bounties-testnet.verdikta.org

# Production-only jobs stay off on the test sites
HUNTER_LINKS_ENABLED=false
SCORE_SPREAD_ENABLED=true
LOG_LEVEL=info
