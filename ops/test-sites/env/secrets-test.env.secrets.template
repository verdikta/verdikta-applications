# TEST secrets -> /root/verdikta/secrets-test/.env.secrets (chmod 600). The test units set
# VERDIKTA_SECRETS_FILE to this file, so the test servers never load /root/verdikta/secrets/.env.secrets.
# Copy over only what may be shared (RPC and IPFS read/pin keys); use NEW values for everything that
# acts or authenticates (keeper wallet, client key, bot key, receipt salt).
INFURA_API_KEY=            # or RPC_URL= ; may be shared with production (read-only)
IPFS_PINNING_KEY=          # may be shared, or a separate Pinata key to keep test pins apart
COINGECKO_API_KEY=         # optional, may be shared
KEEPER_PRIVATE_KEY=        # NEW test wallet, funded with a little ETH; never production's (nonce clashes)
FRONTEND_CLIENT_KEY=       # NEW; the test client's VITE_CLIENT_KEY must match
BOT_API_KEY=               # NEW
RECEIPT_SALT=              # NEW
