# TEST site (v2, beacon branch). Install: see ops/test-sites/README.md.
[Unit]
Description=Verdikta TEST arbiters backend (v2) (:6008)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/verdikta/applications-test/example-arbiters/server
Environment=NODE_ENV=production
Environment=PORT=6008

# The test servers' own secrets (never production's: no shared keeper key or nonces)
Environment=VERDIKTA_SECRETS_FILE=/root/verdikta/secrets-test/.env.secrets
ExecStart=/opt/node22/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/root/verdikta/applications-test/example-arbiters/server/server-test-6008.log
StandardError=append:/root/verdikta/applications-test/example-arbiters/server/server-test-6008.log

[Install]
WantedBy=multi-user.target
