{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "decision": {
      "enum": [
        "PREVIEW",
        "LOCAL",
        "NEEDS_SCOPE",
        "UNSUITABLE",
        "HANDOFF_REQUESTED"
      ]
    },
    "quote_status": {
      "const": "DRAFT_NOT_QUOTED"
    },
    "template_id": {
      "enum": [
        "source-check-v1",
        "evidence-pack-v1",
        "review-v1",
        "real-world-task-v1",
        null
      ]
    },
    "network": {
      "enum": [
        "UNSELECTED",
        "BASE",
        "BASE_SEPOLIA"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "supplier": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "NONE"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "status",
        "candidates"
      ],
      "additionalProperties": false
    },
    "costs": {
      "type": "object",
      "properties": {
        "reward_wei": {
          "type": "null"
        },
        "buyer_gas_estimate_wei": {
          "type": "null"
        },
        "evaluation_prepay_estimate_wei": {
          "type": "null"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reward_wei",
        "buyer_gas_estimate_wei",
        "evaluation_prepay_estimate_wei",
        "explanation"
      ],
      "additionalProperties": false
    },
    "can_commission": {
      "const": false
    },
    "authorization_granted": {
      "const": false
    },
    "funds_moved": {
      "const": false
    },
    "inputs_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "task_summary": {
      "type": "string"
    },
    "price_status": {
      "const": "UNKNOWN"
    },
    "availability_status": {
      "const": "UNKNOWN"
    },
    "procurement": {
      "type": "object",
      "required": [
        "mode",
        "targetHunter"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "UNSELECTED",
            "OPEN",
            "TARGETED"
          ]
        },
        "targetHunter": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "OPEN",
                  "UNSELECTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "targetHunter": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "deliverable": {
      "type": "array"
    },
    "acceptance_criteria": {
      "type": "array"
    },
    "commissioning_requirements": {
      "type": "array"
    },
    "why_outsource": {
      "type": "array"
    },
    "why_not_outsource": {
      "type": "array"
    },
    "draft": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "template_id",
            "request",
            "rubric",
            "threshold",
            "procurement",
            "sharing_authorized"
          ],
          "additionalProperties": false,
          "properties": {
            "template_id": {
              "enum": [
                "source-check-v1",
                "evidence-pack-v1",
                "review-v1",
                "real-world-task-v1"
              ]
            },
            "request": {
              "type": "object"
            },
            "rubric": {
              "type": "object"
            },
            "threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "procurement": {
              "allOf": [
                {
                  "type": "object",
                  "required": [
                    "mode",
                    "targetHunter"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "enum": [
                        "UNSELECTED",
                        "OPEN",
                        "TARGETED"
                      ]
                    },
                    "targetHunter": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^0x[0-9a-fA-F]{40}$"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "mode": {
                            "enum": [
                              "OPEN",
                              "UNSELECTED"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "targetHunter": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "properties": {
                    "mode": {
                      "enum": [
                        "OPEN",
                        "TARGETED"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "TARGETED"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "targetHunter": {
                        "type": "string",
                        "not": {
                          "const": "0x0000000000000000000000000000000000000000"
                        }
                      }
                    }
                  }
                }
              ]
            },
            "sharing_authorized": {
              "const": true
            }
          }
        }
      ]
    },
    "local_summary": {
      "description": "What the agent resolved itself, and how. Never part of the commissioned request and never independent verification. Appears only with a draft.",
      "type": "object",
      "required": [
        "mode",
        "independent",
        "performed_by",
        "original_task_id",
        "original_item_count",
        "method",
        "resolved",
        "residual",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "RESIDUAL",
            "NON_INDEPENDENT_PASS"
          ],
          "description": "RESIDUAL: resolved items were removed from the draft request. NON_INDEPENDENT_PASS: every item stays in the draft request and the local pass is informational."
        },
        "independent": {
          "const": false
        },
        "performed_by": {
          "const": "AGENT"
        },
        "original_task_id": {
          "type": "string",
          "minLength": 1
        },
        "original_item_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "verdict",
              "source_url",
              "basis"
            ],
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "verdict": {
                "enum": [
                  "SUPPORTED",
                  "CONTRADICTED",
                  "FOUND"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "source_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "verdict": {
                      "const": "FOUND"
                    }
                  },
                  "required": [
                    "verdict"
                  ]
                },
                "then": {
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "residual": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_id",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "UNRESOLVED_ABSENT",
                  "CONFLICTING",
                  "INACCESSIBLE",
                  "NEEDS_JUDGMENT",
                  "INDEPENDENT_REVIEW_REQUESTED"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "grid_overlap": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Evidence packs only: cells inside the drafted grid that were already resolved locally."
        },
        "limitations": {
          "type": "string"
        }
      }
    },
    "market_context": {
      "description": "Aggregate public context about comparable bounties, with provenance. Never a quote: it does not fill costs, price_status or availability_status.",
      "type": "object",
      "required": [
        "source_url",
        "fetched_at",
        "network",
        "window_days",
        "service_scope",
        "sample_size",
        "not_a_quote",
        "summary",
        "caveat"
      ],
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "pattern": "^https://[^/?#]+/api/(market-summary|jobs\\.txt)$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "network": {
          "enum": [
            "BASE",
            "BASE_SEPOLIA"
          ]
        },
        "window_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "service_scope": {
          "enum": [
            "source-check-v1",
            "evidence-pack-v1",
            "review-v1",
            "real-world-task-v1",
            "unclassified",
            "all"
          ]
        },
        "sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "not_a_quote": {
          "const": true
        },
        "fallback": {
          "enum": [
            "NONE",
            "JOBS_TXT"
          ]
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "open": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "awarded_in_window": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "closed_unawarded_in_window": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "median_bounty_amount_wei": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "p25_bounty_amount_wei": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "p75_bounty_amount_wei": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "median_time_to_award_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "median_oracle_prepay_wei": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "active_hunters": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "caveat": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "schema_version",
    "decision",
    "quote_status",
    "template_id",
    "network",
    "reason",
    "supplier",
    "costs",
    "can_commission",
    "authorization_granted",
    "funds_moved",
    "inputs_needed",
    "risks",
    "next_action",
    "draft",
    "procurement"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "LOCAL",
              "UNSUITABLE",
              "NEEDS_SCOPE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "draft": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "PREVIEW",
              "HANDOFF_REQUESTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "draft": {
            "type": "object"
          },
          "procurement": {
            "properties": {
              "mode": {
                "enum": [
                  "OPEN",
                  "TARGETED"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "TARGETED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "targetHunter": {
                      "type": "string",
                      "not": {
                        "const": "0x0000000000000000000000000000000000000000"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "draft": {
            "type": "object",
            "properties": {
              "procurement": {
                "properties": {
                  "mode": {
                    "const": "OPEN"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "procurement": {
            "properties": {
              "mode": {
                "const": "OPEN"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "draft": {
            "type": "object",
            "properties": {
              "procurement": {
                "properties": {
                  "mode": {
                    "const": "TARGETED"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "procurement": {
            "properties": {
              "mode": {
                "const": "TARGETED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "local_summary"
        ]
      },
      "then": {
        "properties": {
          "draft": {
            "type": "object"
          }
        }
      }
    }
  ]
}
