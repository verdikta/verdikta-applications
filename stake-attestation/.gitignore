# The server's chain tests: onchain/contracts copied in, compiled on the in-process network
server/.hardhat/

# The tool's chain tests: the same, for the hunter tool
tool/.hardhat/

# The server's indexer and keeper state (SA_DATA_DIR default)
server/data/

# The local round: verdikta-arbiter at the pin, and the logs of the last run
e2e/.arbiter/
e2e/.round/
