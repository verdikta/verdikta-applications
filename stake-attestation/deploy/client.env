# The client's build environment for https://verifiers.verdikta.org (node P23; stake-attestation/README.md, "Running
# the site"; the variables: client/src/config.js). Copy it to client/.env.production.local (untracked), fill in the
# contract, and `npm run build`: Vite reads that file. Vite writes these values into the bundle, so each one is public:
# never an RPC URL with a key in it.
#
# The RPC endpoint and the gateways are the client's only calls off its own origin, so the Content-Security-Policy's
# connect-src names their origins (nginx/verifiers.verdikta.org-headers.conf). Change one here and change it there: a
# test holds the two files to each other (shared/test/repo/deploy.test.js).

# Base Sepolia.
VITE_SA_CHAIN_ID=84532
# Per deployment: contracts.StakeAttestation in onchain/deployments/84532-base_sepolia.json (launch step 1).
VITE_SA_CONTRACT=
# Base's public endpoint, for the chain reads a visitor makes without a wallet (the check and claim pages).
VITE_SA_RPC_URL=https://sepolia.base.org
# Public path gateways that serve any CID with CORS, comma-separated: the check page reads a hunter's disclosed
# ciphertext from the first, and from the next only when one fails to deliver (a network error, an answer that is not
# 2xx, or no whole body within 60 s; client/src/lib/fetchCiphertext.js). The bytes are checked against the claim's
# ciphertextSha256 on the chain, so a gateway is trusted for nothing but delivery. The record page links to the first.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud,https://ipfs.io
