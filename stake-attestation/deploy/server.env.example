# The server's environment for https://verifiers.verdikta.org on Base Sepolia (node P23; stake-attestation/README.md,
# "Running the site"; every variable: server/src/config.js). Production trust, the workflow backend, a real pinning
# backend. Copy it to /etc/verdikta-verifiers/server.env (root:verifiers, mode 0640), the unit's EnvironmentFile, and
# fill in the empty settings. Never commit the filled copy.
#
# The form is systemd's: NAME=value, nothing quoted, a comment only on a line of its own (systemd would read a comment
# after a value as part of it). An empty setting is the code's default; a line `# NAME=value` shows a default and sets
# nothing. A credential is named here and read by the server only when it uses it (config.js).
#
# The aggregator is not the server's: it is the contract's constructor argument (launch step 1,
# VERDIKTA_AGGREGATOR_BASE_SEPOLIA=0xe8a385E473EA710c5a88Cc72681a16a26fe380e4, onchain/.env.example), recorded in the
# deployment JSON as contracts.VerdiktaAggregator. The server reads it from nowhere.

# ---------------------------------------------------------------- fixed by this deployment
NODE_ENV=production
HOST=127.0.0.1
PORT=5009
SA_CHAIN_ID=84532
SA_ATTESTATION_TRUST=production
SA_BUILD_BACKEND=workflow

# ---------------------------------------------------------------- the deployment (launch step 1)
# contracts.StakeAttestation in onchain/deployments/84532-base_sepolia.json, which deploy_testnet.sh writes
SA_CONTRACT_ADDRESS=
# deploymentBlock in the same file: where the indexer starts
SA_FROM_BLOCK=
# Secret: a Base Sepolia JSON-RPC endpoint for the indexer and the keeper. A provider's URL can carry its key in the
# path. Read when the provider is made, never logged. Not the client's public endpoint, whose limits are a visitor's.
SA_RPC_URL=
# SA_CONFIRMATIONS=10
# SA_REORG_WINDOW_BLOCKS=512
# SA_LOG_CHUNK_BLOCKS=2000
# SA_INDEXER_POLL_MS=15000
# SA_MAX_STALENESS_SECONDS=600
# SA_RECORD_LISTING_PAGE=50
# SA_RECORD_ITEM_PAGE=200

# ---------------------------------------------------------------- state (the unit's StateDirectory)
# The indexer's and keeper's state and the build budget's counts. Keep it across upgrades (README).
SA_DATA_DIR=/var/lib/verdikta-verifiers/data

# ---------------------------------------------------------------- the keeper (one per deployment, README)
# Secret: the keeper's private key, an account of its own made for this deployment and funded with a little Base
# Sepolia ETH for gas. It sends finalize, confirm and settle. Read when the keeper starts; never kept in the config.
SA_KEEPER_PRIVATE_KEY=
# SA_KEEPER=on
# SA_KEEPER_POLL_MS=30000
# SA_KEEPER_TX_TIMEOUT_MS=120000
# SA_KEEPER_REPLACE_AFTER_MS=180000
# SA_KEEPER_MAX_FEE_PER_GAS_WEI=10000000000
# SA_KEEPER_EXPIRE=off
# SA_KEEPER_CONFIRM=on

# ---------------------------------------------------------------- the workflow backend (docs/builder-kms-signing.md)
# The caller repository, verdikta/<caller>: the owner's steps at G1, step 4
SA_BUILD_WORKFLOW_REPO=
# Secret: a token with Actions read and write on the caller and nothing else (the owner's steps at G1, step 6)
SA_BUILD_WORKFLOW_TOKEN=
# this site's prefix in a run's name: the server cancels only runs under its own
SA_BUILD_WORKFLOW_SITE=verifiers
# SA_BUILD_WORKFLOW_FILE=stake-attestation-site-build.yml
# SA_GITHUB_API_URL=https://api.github.com
# SA_BUILD_POLL_MS=30000
# SA_BUILD_FIND_MS=300000
# SA_BUILD_RUN_DEADLINE_MS=10800000
# SA_BUILD_APPROVAL_DEADLINE_MS=259200000
# SA_BUILD_SWEEP_MS=300000
# SA_BUILD_LIMIT_PER_WALLET=3
# SA_BUILD_LIMIT_PER_REPO_OWNER=5
# SA_BUILD_LIMIT_OVERALL=20
# SA_BUILD_LIMIT_WINDOW_MS=86400000
# SA_BUILD_ARTIFACT_MAX_BYTES=67108864
# SA_MAX_CONCURRENT_BUILDS=1
# SA_MAX_QUEUED_BUILDS=8

# ---------------------------------------------------------------- the baseline scan, on this host
# The builder's config for the scan (deploy/builder.json): the one builder step this host runs
SA_BUILDER_CONFIG=/etc/verdikta-verifiers/builder.json
# Each build's folder, the scan's included (the listed commit's objects, its temporary files)
SA_BUILDER_WORK_DIR=/var/lib/verdikta-verifiers/work
# The scan reaches the service user's rootless Docker by this variable, passed to it by name
SA_BUILDER_SCAN_ENV=DOCKER_HOST
# unix:///run/user/<uid>/docker.sock, with the service user's uid (id -u verifiers): its rootless daemon's socket
DOCKER_HOST=
# SA_SCAN_AGENT=off
# SA_BUILDER_TIMEOUT_MS=14400000
# SA_BUILDER_GRACE_MS=30000
# SA_BUILDER_BIN=../builder/bin/verdikta-build-env.js
# With the workflow backend, build and sign run in the signing workflow, never here, so these two are not used:
# SA_BUILDER_BUILD_ENV=
# SA_BUILDER_SIGN_ENV=

# ---------------------------------------------------------------- pinning (both archives, and dispute statements)
SA_PINNING=pinata
# Secret: a Pinata JWT allowed to pin files, from the owner's pinning account
SA_PINATA_JWT=
# SA_PINATA_API_URL=https://api.pinata.cloud
# SA_PIN_TIMEOUT_MS=60000
# Another backend instead (mock is refused in production): SA_PINNING=filebase, with its token (a secret) and its API,
# SA_FILEBASE_TOKEN=
# SA_FILEBASE_RPC_URL=
# or SA_PINNING=kubo, with a daemon's RPC API on loopback:
# SA_KUBO_API_URL=http://127.0.0.1:5001

# ---------------------------------------------------------------- archives and justifications, read back
# Operator-preferred gateways, comma-separated https URLs, tried before @verdikta/common's own list
# SA_IPFS_GATEWAYS=
# SA_ARCHIVE_MAX_BYTES=8388608
# SA_ARCHIVE_TIMEOUT_MS=30000
# SA_ARCHIVE_RETRY_MS=30000

# ---------------------------------------------------------------- labels: testnet launch values (owner decision)
# Owner decision Q76, 2026-11-12, for the testnet launch; they are revisited before mainnet.
# Below 0.01 ETH of top award a stake is only "scanned".
SA_BADGE_FLOOR_WEI=10000000000000000
# Under 10% of the declared value at risk, "under-staked".
SA_UNDER_STAKED_RATIO_BPS=1000
# Chainlink's ETH / USD price feed on Base Sepolia, its proxy address as Chainlink's data feeds documentation lists it
# (heartbeat 20 min, 8 decimals)
SA_ETH_USD_FEED=0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1
# SA_ETH_USD_MAX_AGE_SECONDS=3600

# ---------------------------------------------------------------- the project's proof (docs/control-proof.md)
# SA_CONTROL_GIT_HOSTS=github.com,gitlab.com,codeberg.org,bitbucket.org
# SA_CONTROL_CHECK_BIN=../builder/bin/verdikta-control-check.js
# SA_CONTROL_CHECK_TIMEOUT_MS=120000
# SA_CONTROL_CHECK_MAX_BYTES=268435456
# SA_CONTROL_RETRY_MS=60000
# SA_CONTROL_RECHECK_MS=86400000
# SA_CONTROL_RPC_TIMEOUT_MS=10000
# SA_CONTROL_FORK_TIMEOUT_MS=10000
# Secret, optional: a contract listing on another chain than Base Sepolia needs that chain's JSON-RPC endpoint (for
# Base, SA_CONTROL_RPC_URL_8453). A contract on a chain with none is "no".
# SA_CONTROL_RPC_URL_<chain id>=
# Secret, optional: a GitHub token with no scope raises GitHub's rate limit for the record's fork label
# SA_GITHUB_TOKEN=
# SA_CONTROL_GIT_MIRROR_DIR is for development only and refused with NODE_ENV=production: never set it here.

# ---------------------------------------------------------------- the oracle parameters list() takes (defaults kept)
# SA_ORACLE_MAX_FEE_WEI=120000000000000
# SA_ORACLE_DISPUTE_MAX_FEE_WEI=200000000000000
# SA_ORACLE_BASE_COST_WEI=10000000000000
# SA_ORACLE_ALPHA=500
# SA_ORACLE_MAX_FEE_SCALING=3

# ---------------------------------------------------------------- the maker's sign-in
# SA_AUTH_CHALLENGE_TTL_MS=300000
