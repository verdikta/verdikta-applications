# The deploy scripts' environment (deploy_testnet.sh, deploy_mainnet.sh,
# deploy/01_deploy_stake_attestation.js). Export these in the shell, or copy this file to .env
# (untracked: the repository ignores .env), which the shell scripts load if it exists.
# Nothing here is read by the tests, which run on the in-process network.

# The deployer's private key. Never commit it; prefer exporting it in the shell.
# PRIVATE_KEY=

# The ETH-funded Verdikta aggregator (ReputationAggregator), per network: the ones
# example-bounty-program/onchain/.env.example names. They are network state: check them first.
VERDIKTA_AGGREGATOR_BASE_SEPOLIA=0xe8a385E473EA710c5a88Cc72681a16a26fe380e4
VERDIKTA_AGGREGATOR_BASE=0xd8F38bCBEE43bE3bd31655a563f20c9B3e67142a

# StakeAttestation's constructor. Fixed per deployment except the listing fee and its
# recipient, which the owner may change for later funds and renewals (assumption A5).
SA_INITIAL_OWNER=
SA_FEE_RECIPIENT=
# Wei per 30-day listing period, a whole number (0.01 ETH = 10000000000000000).
SA_LISTING_FEE_WEI=

# Optional.
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# BASE_RPC_URL=https://mainnet.base.org
# ETHERSCAN_API_KEY=
# SA_CONFIRM_MAINNET=base
